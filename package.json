{
  "name": "planet-vpn",
  "version": "1.0.0",
  "description": "planet-vpn",
  "main": "",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-tests",
    "test:grep": "playwright test -g",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report:serve": "allure serve allure-results",
    "lint": "eslint -c .eslintrc.json --ext .js,.ts .",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "code-style-fix": "npm run lint -- --fix",
    "playwright:install": "playwright install chromium"
  },
"dependencies": {
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "^1.64.1",
    "allure-playwright": "3.4.2",
    "date-fns": "4.1.0",
    "node-fetch": "2.7.0",
    "playwright": "1.64.1",
    "randomstring": "1.3.1",
    "ts-node": "10.9.2"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "6.13.1",
    "@typescript-eslint/parser": "6.13.1",
    "allure-playwright": "3.4.2",
    "eslint": "8.54.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-airbnb-typescript": "17.1.0",
    "eslint-config-prettier": "9.0.0",
    "eslint-plugin-import": "2.29.0",
    "eslint-plugin-prettier": "5.0.1",
    "prettier": "3.2.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "braces": "^3.0.3"
}
}
